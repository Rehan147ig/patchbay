    "@patchbay/policy-engine": "workspace:*",
    "@patchbay/queue": "workspace:*",
    "@patchbay/remediation-engine": "workspace:*",
    "@patchbay/repo-analysis": "workspace:*",
    "@patchbay/ui": "workspace:*",
    "@patchbay/vendor-connectors": "workspace:*",
    "next": "^15.3.0",
    "next-auth": "^4.24.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
