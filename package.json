{
  "name": "patchbay",
  "private": true,
  "version": "0.1.0",
  "description": "Patchbay - governed API-change remediation platform (MVP)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,worker -c cyan,magenta \"pnpm --filter @patchbay/web dev\" \"pnpm --filter @patchbay/worker dev\"",
    "build": "pnpm --filter @patchbay/web build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:corpus": "vitest run packages/remediation-engine/src/eval-corpus.test.ts",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @patchbay/db generate",
    "db:migrate": "pnpm --filter @patchbay/db migrate",
    "db:seed": "pnpm --filter @patchbay/db seed",
    "db:reset": "pnpm --filter @patchbay/db reset",
    "generate:capability-matrix": "tsx scripts/generate-capability-matrix.ts",
    "verify:capability-matrix": "tsx scripts/generate-capability-matrix.ts --check",
    "verify:lockfile": "pnpm install --frozen-lockfile",
    "e2e": "playwright test",
    "test:redis-integration": "vitest run --config vitest.redis.config.ts",
    "test:production": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:corpus && pnpm build && pnpm e2e",
    "pyright": "pyright",
    "verify:python": "pnpm pyright && tsx packages/repo-analysis/scripts/verify-python-gate.ts"
  },
  "devDependencies": {
    "@dodopayments/opencode-plugin": "^0.5.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "pyright": "^1.1.399",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "nanoid": "^3.3.17",
      "sharp": "^0.35.4",
      "deepmerge-ts": "^8.0.0",
      "js-yaml": "^4.3.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
