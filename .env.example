# ---------------------------------------------------------------------------
# Patchbay local development environment.
# Copy to .env at the repository root. Never commit real values.
# All values below are safe for local development only.
# ---------------------------------------------------------------------------

# PostgreSQL connection (matches docker-compose.yml; 5434 on the host)
DATABASE_URL="postgresql://patchbay:patchbay_dev_only@localhost:5434/patchbay?schema=public"

# Redis connection (matches docker-compose.yml; 6380 on the host)
REDIS_URL="redis://localhost:6380"

# App
NODE_ENV=development
PORT=3000

# Dev authentication (local MVP only). REQUIRED outside production — session
# cookies are HMAC-signed with this secret and login refuses to start without
# it. Must be at least 32 characters. Generate one locally:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEV_AUTH_SECRET=

# Seed/demo identity
DEMO_USER_EMAIL=demo@patchbay.dev
DEMO_USER_PASSWORD=dev-only

# AI provider: "mock" is deterministic and requires no credentials.
# "ai-sdk" (Vercel AI SDK, recommended) and "openai-compatible" (legacy REST
# client) are optional and gated behind an API key.
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI SDK tuning (AI_PROVIDER=ai-sdk only):
# AI_TIMEOUT_MS=60000
# AI_MAX_OUTPUT_TOKENS=2048
# AI_MAX_RETRIES=2
# AI_ALLOWED_MODELS=gpt-4o-mini
# AI_ALLOWED_BASE_URL_HOSTS=api.openai.com
# AI_CIRCUIT_MAX_FAILURES=5
# AI_CIRCUIT_COOLDOWN_MS=30000

# GitHub integration (optional; not required for local development).
# GitHub App: enables per-organization installations, real draft PRs via
# installation tokens, and webhook ingestion. GITHUB_APP_PRIVATE_KEY is the
# PEM file base64-encoded (single line).
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# Public slug of the GitHub App (from its GitHub settings URL), used to build
# the "Install" link on /settings/github.
# GITHUB_APP_SLUG=
# GitHub OAuth sign-in (powers "Continue with GitHub" on /login).
# When unset, the dev session cookie remains the only auth mechanism.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=
# PAT fallback (single-repository mode; superseded by the GitHub App above).
# When GITHUB_TOKEN and GITHUB_REPOSITORY are both set, Patchbay opens real
# draft PRs on that repository.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo
# Optional: base URL override for the GitHub API (testing only).
# GITHUB_API_URL=

# Sandbox runner (execution safety boundary)
SANDBOX_TIMEOUT_MS=120000
SANDBOX_MAX_OUTPUT_CHARS=20000
# SANDBOX_MODE: development (default), test, or production.
# In production, process runtime is rejected at startup and validation time,
# and the worker refuses to start if container runtime is unavailable.
# SANDBOX_MODE=development
# SANDBOX_RUNTIME: process (default for local iteration) or container (REQUIRED for production).
# Threat model warning: process is not a multi-tenant sandbox — commands execute on
# the host. Production deployments require container isolation (Docker daemon).
SANDBOX_RUNTIME=process
# SANDBOX_RUNTIME=container
# Container image for SANDBOX_RUNTIME=container. node:20-slim ships npm but
# not pnpm; pnpm commands need a pnpm-baked image.
# SANDBOX_IMAGE=node:20-slim
# Immutable dependency cache for container runs: mounted read-only, so
# installs cannot reach the network while still resolving dependencies.
# SANDBOX_NPM_CACHE=C:\path\to\immutable-cache

# Ingress trust for rate limiting: comma-separated CIDRs allowed to set
# x-forwarded-for. Empty (default) = trust no proxy; the header is ignored.
TRUSTED_PROXY_CIDRS=

# Watchtower raw evidence object store (content-addressed). Defaults to
# ./data/evidence under the repository root when unset.
# EVIDENCE_STORE_DIR=

# Stripe billing (optional; when unset, billing routes 503 and every
# organization stays FREE). STRIPE_WEBHOOK_SECRET is the signing secret from
# Dashboard -> Developers -> Webhooks; STRIPE_PRICE_* are monthly recurring
# price ids from the product catalog.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_TEAM_MONTHLY=
