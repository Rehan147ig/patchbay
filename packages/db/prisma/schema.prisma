// ---------------------------------------------------------------------------
// Patchbay domain model.
// Enum values MUST mirror packages/domain/src/enums.ts (enforced by a drift test).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum RepositoryProvider {
  GITHUB
  LOCAL
}

enum RepositoryStatus {
  ACTIVE
  ARCHIVED
}

/** Stripe-backed subscription tiers. Repo caps: FREE=1, PRO=10, TEAM=50, ENTERPRISE=unlimited. */
enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum VendorChangeSource {
  MANUAL
  SDK_RELEASE
  OPENAPI_DIFF
  CHANGELOG
  WEBHOOK
}

enum VendorChangeStatus {
  DETECTED
  TRIAGED
  REMEDIATION_STARTED
  RESOLVED
  IGNORED
}

enum ChangeType {
  SDK_VERSION_UPGRADE
  METHOD_RENAMED
  METHOD_REMOVED
  PARAMETER_RENAMED
  PARAMETER_REMOVED
  PARAMETER_REQUIRED
  RESPONSE_FIELD_REMOVED
  RESPONSE_FIELD_TYPE_CHANGED
  ENDPOINT_REMOVED
  AUTH_CHANGE
  WEBHOOK_CHANGE
  NEW_CAPABILITY
  OTHER
}

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum UsageType {
  IMPORT
  INITIALIZATION
  METHOD_CALL
  ENDPOINT_CALL
  CONFIG
  WEBHOOK
  ENVIRONMENT_REFERENCE
}

enum RiskTag {
  PAYMENT
  AUTH
  PII
  WEBHOOK
  INFRASTRUCTURE
  TEST_ONLY
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImpactStatus {
  NOT_AFFECTED
  POSSIBLY_AFFECTED
  AFFECTED
  NEEDS_REVIEW
}

enum PlanStatus {
  DRAFT
  READY_FOR_VALIDATION
  VALIDATING
  VALIDATED
  BLOCKED
  PR_CREATED
  FAILED
}

enum GenerationMethod {
  RULE_BASED
  AI_ASSISTED
  MANUAL
}

enum ValidationStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  SKIPPED
}

enum PullRequestStatus {
  DRAFT
  OPEN
  MERGED
  CLOSED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ActorType {
  USER
  SYSTEM
  AGENT
}

enum PolicyDecision {
  ALLOW_PLAN_ONLY
  ALLOW_VALIDATE
  ALLOW_DRAFT_PR
  REQUIRE_APPROVAL
  DENY
}

// ---------------------------------------------------------------------------
// Release Watchtower enums. Must mirror packages/domain/src/enums.ts.
// ---------------------------------------------------------------------------

enum ReleaseSource {
  NPM
  GITHUB_RELEASE
  OPENAPI
  VENDOR_MANIFEST
  CHANGELOG
}

enum ReleaseAuthenticity {
  VERIFIED
  SOURCE_TRUSTED
  UNVERIFIED
}

enum ReleaseStatus {
  OBSERVED
  CLASSIFIED
  FAILED
}

enum ReleaseMatchStatus {
  CANDIDATE
  NOT_RELEVANT
  MONITOR
  REVIEW
  REMEDIATE
}

enum DetectionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReleaseClassificationMethod {
  DETERMINISTIC
  AI
  MANUAL
}

// ---------------------------------------------------------------------------
// Agent Harness enums. Must mirror packages/domain/src/enums.ts.
// ---------------------------------------------------------------------------

enum AgentRunType {
  PLAN_GENERATION
  PLAN_REVIEW
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  BUDGET_EXCEEDED
}

enum AgentRole {
  ANALYST
  PLANNER
  REVIEWER
}

enum AgentStepKind {
  WORKFLOW
  TOOL_CALL
  MODEL_CALL
}

enum AgentStepStatus {
  STARTED
  COMPLETED
  FAILED
}

enum TaskStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id String @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users                  User[]
  repositories           Repository[]
  scans                  RepositoryScan[]
  usages                 IntegrationUsage[]
  impactAssessments      ImpactAssessment[]
  impactAssessmentUsages ImpactAssessmentUsage[]
  plans                  RemediationPlan[]
  patches                PatchArtifact[]
  validations            ValidationRun[]
  pullRequests           PullRequest[]
  approvals              Approval[]
  policies               Policy[]
  auditEvents            AuditEvent[]
  githubInstallations    GitHubInstallation[]
  webhookDeliveries      WebhookDelivery[]
  repositoryDependencies RepositoryDependency[]
  releaseMatches         ReleaseRepositoryMatch[]
  agentRuns              AgentRun[]
  agentSteps             AgentStep[]
  graphSnapshots         GraphSnapshot[]
  graphNodes             GraphNode[]
  graphEdges             GraphEdge[]
  graphEvidence          GraphSourceEvidence[]
  graphIndexJobs         GraphIndexJob[]
  subscription           Subscription?
}

/** Stripe billing subscription for one organization (1:1 with Organization). */
model Subscription {
  id                    String             @id @default(uuid())
  organizationId        String             @unique
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  planTier              PlanTier           @default(FREE)
  status                SubscriptionStatus @default(TRIALING)
  currentPeriodEnd      DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

model User {
  id String @id @default(uuid())
  organizationId String
  email          String   @unique
  name           String
  role           Role
  // Bumped on privilege changes; sessions carry the version they were issued
  // at, so demoted/removed users are forced to re-authenticate.
  sessionVersion Int      @default(0)
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvals    Approval[]
  accounts     Account[]
  sessions     Session[]

  @@index([organizationId])
}

// NextAuth (Auth.js v4) adapter models — power GitHub OAuth sign-in.
model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  deliveryId     String    @unique
  event          String
  payloadHash    String
  status         String    @default("RECEIVED")
  organizationId String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  error          String?   @db.Text

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([organizationId, receivedAt])
  @@index([payloadHash, receivedAt])
}

// A GitHub App installation bound to a Patchbay organization. Created via the
// authenticated post-install callback, enriched/suspended via webhooks.
model GitHubInstallation {
  id                  String    @id @default(uuid())
  organizationId      String
  installationId      Int       @unique
  accountLogin        String
  accountType         String // "Organization" or "User"
  repositorySelection String // "all" or "selected"
  permissions         Json
  installedAt         DateTime  @default(now())
  suspendedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Repository {
  id String @id @default(uuid())
  organizationId  String
  provider        RepositoryProvider
  externalId      String
  name            String
  fullName        String
  defaultBranch   String             @default("main")
  languageProfile Json
  status          RepositoryStatus   @default(ACTIVE)
  metadata        Json
  createdAt       DateTime           @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scans              RepositoryScan[]
  usages             IntegrationUsage[]
  impactAssessments  ImpactAssessment[]
  dependencies       RepositoryDependency[]
  releaseMatches     ReleaseRepositoryMatch[]
  agentRuns          AgentRun[]
  graphSnapshots     GraphSnapshot[]
  graphNodes         GraphNode[]
  graphEdges         GraphEdge[]
  graphEvidence      GraphSourceEvidence[]
  graphIndexJobs     GraphIndexJob[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([name])
}

model RepositoryScan {
  id String @id @default(uuid())
  organizationId String
  repositoryId   String
  commitSha      String
  status         ScanStatus  @default(QUEUED)
  startedAt      DateTime?
  completedAt    DateTime?
  summary        Json?
  error          String?
  createdAt      DateTime    @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  usages       IntegrationUsage[]

  @@index([organizationId])
  @@index([repositoryId, status])
  @@index([repositoryId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model Vendor {
  id String @id @default(uuid())
  slug    String  @unique
  name    String
  category String
  docsUrl String?
  enabled Boolean @default(true)
  /** Owning organization; required once provider-agent mode is enabled. */
  organizationId String?
  /**
   * argon2id hash of the current agent API key (legacy sha256 hex hashes are
   * verified during the migration window until the key is rotated).
   */
  agentKeyHash String?
  /**
   * argon2id hash of the previous agent API key. Kept until rotation settles:
   * agents authenticating with the old key still work while the new key is
   * being rolled out, and the previous hash is dropped on the next rotation.
   */
  agentKeyHashPrevious String?

  changeEvents VendorChangeEvent[]
  usages       IntegrationUsage[]
  products     VendorProduct[]
}

model VendorProduct {
  id String @id @default(uuid())
  vendorId     String
  ecosystem    String
  packageName  String
  repositoryUrl String?
  openApiUrl   String?
  enabled      Boolean @default(true)
  createdAt    DateTime @default(now())

  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  releases ReleaseRecord[]

  @@unique([vendorId, ecosystem, packageName])
  @@index([ecosystem, enabled])
}

/**
 * One upstream release, stored once globally. Tenant impact is derived
 * separately per organization/repository (ReleaseRepositoryMatch).
 * Identity: sha256(source + vendorSlug + product + version + contentHash).
 */
model ReleaseRecord {
  id String @id @default(uuid())
  productId        String
  source           ReleaseSource
  version          String
  previousVersion  String?
  publishedAt      DateTime
  canonicalUrl     String
  contentHash      String
  authenticity     ReleaseAuthenticity @default(SOURCE_TRUSTED)
  status           ReleaseStatus       @default(OBSERVED)
  createdAt        DateTime            @default(now())

  product         VendorProduct          @relation(fields: [productId], references: [id], onDelete: Cascade)
  evidence        ReleaseEvidence[]
  classifications ReleaseClassification[]
  matches         ReleaseRepositoryMatch[]
  agentRuns       AgentRun[]

  @@unique([source, productId, version, contentHash])
  @@index([productId, publishedAt])
  @@index([status])
  @@index([publishedAt])
}

model ReleaseEvidence {
  id String @id @default(uuid())
  releaseRecordId String
  kind            String
  /** Content-addressed key; raw bytes live in tenant-neutral object storage. */
  objectStorageKey String
  contentHash      String
  metadataJson     Json?
  createdAt        DateTime @default(now())

  releaseRecord ReleaseRecord @relation(fields: [releaseRecordId], references: [id], onDelete: Cascade)

  @@index([releaseRecordId])
}

/** Lockfile-resolved dependency inventory, keyed by repository commit SHA. */
model RepositoryDependency {
  id String @id @default(uuid())
  organizationId String
  repositoryId   String
  packageName    String
  declaredRange  String?
  resolvedVersion String
  lockfileKind   String
  commitSha      String
  observedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  matches      ReleaseRepositoryMatch[]

  @@unique([repositoryId, packageName, commitSha])
  @@index([organizationId])
  @@index([packageName])
}

/** Tenant-owned result of matching one global release against one repository. */
model ReleaseRepositoryMatch {
  id String @id @default(uuid())
  releaseRecordId      String
  organizationId       String
  repositoryId         String
  dependencyId         String
  matchReason          String
  affectedVersionRange String?
  status               ReleaseMatchStatus @default(CANDIDATE)
  createdAt            DateTime           @default(now())

  releaseRecord ReleaseRecord      @relation(fields: [releaseRecordId], references: [id], onDelete: Cascade)
  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository    Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  dependency    RepositoryDependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)
  agentRuns     AgentRun[]

  @@unique([releaseRecordId, repositoryId, dependencyId])
  @@index([organizationId, status])
  @@index([releaseRecordId])
}

/** Structured classification of a release (deterministic facts today, AI later). */
model ReleaseClassification {
  id String @id @default(uuid())
  releaseRecordId      String
  method               ReleaseClassificationMethod
  factsJson            Json
  confidence           Int
  confidenceBreakdown  Json
  requiresHumanReview  Boolean
  modelTraceId         String?
  createdAt            DateTime @default(now())

  releaseRecord ReleaseRecord @relation(fields: [releaseRecordId], references: [id], onDelete: Cascade)

  @@unique([releaseRecordId])
}

// ---------------------------------------------------------------------------
// Agent Harness (bounded, typed, replayable AI runs).
// An AgentRun is one analyst -> planner -> reviewer execution for one
// (release, match). Stores redacted input digests, schema-validated outputs,
// token/cost accounting and terminal status. No chain-of-thought, no secrets.
// ---------------------------------------------------------------------------

model AgentRun {
  id String @id @default(uuid())
  organizationId String
  releaseRecordId String
  repositoryId String
  releaseRepositoryMatchId String?
  type AgentRunType @default(PLAN_REVIEW)
  status AgentRunStatus @default(QUEUED)
  correlationId String
  model String
  promptTemplateVersion String
  /** sha256 of the sanitized, bounded input context (replay identity). */
  redactedInputDigest String
  inputJson Json
  outputJson Json?
  tokenUsage Json?
  costEstimateCents Int @default(0)
  budgetCents Int @default(0)
  error String?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  releaseRecord ReleaseRecord @relation(fields: [releaseRecordId], references: [id], onDelete: Cascade)
  repository  Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  match      ReleaseRepositoryMatch? @relation(fields: [releaseRepositoryMatchId], references: [id], onDelete: SetNull)
  steps      AgentStep[]

  @@index([organizationId, status])
  @@index([organizationId, releaseRecordId, repositoryId])
  @@index([releaseRecordId, createdAt])
}

model AgentStep {
  id String @id @default(uuid())
  organizationId String
  agentRunId String
  role AgentRole
  kind AgentStepKind
  status AgentStepStatus @default(STARTED)
  toolName String?
  /** sha256 of the sanitized step input; enables replay comparison. */
  inputDigest String
  outputJson Json?
  tokenUsage Json?
  latencyMs Int?
  error String?
  startedAt DateTime @default(now())
  completedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
}

/** One adapter poll cycle; cursor/status/error surface for detector health UI. */
model DetectionRun {
  id String @id @default(uuid())
  adapter       String
  status        DetectionRunStatus @default(RUNNING)
  startedAt     DateTime           @default(now())
  completedAt   DateTime?
  cursor        Json?
  observedCount Int                @default(0)
  error         String?

  @@index([adapter, startedAt])
}

/**
 * Single run of the activation task-management loop. Submission is
 * idempotent per (taskId, type): retries overwrite inputs, never duplicate.
 */
model TaskParameter {
  id         String     @id @default(uuid())
  taskId     String
  type       String
  /** Executor domain, e.g. "NPM". Nullable so legacy rows stay loadable. */
  domain     String?
  status     TaskStatus @default(PENDING)
  error      String?
  inputJson  Json?
  outputJson Json?
  deadline   DateTime?
  startedAt  DateTime   @default(now())
  createdAt  DateTime   @default(now())

  @@unique([taskId, type])
  @@index([type, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Software Intelligence Graph (impact graph).
// Every fact is org-scoped, snapshot-scoped, and content-addressed.
// Must mirror packages/domain/src/enums.ts (drift test).
// ---------------------------------------------------------------------------

enum GraphSnapshotStatus {
  INDEXING
  READY
  FAILED
}

enum GraphIndexMode {
  BASELINE
  INCREMENTAL
}

enum GraphNodeKind {
  REPOSITORY
  FILE
  MODULE
  SYMBOL
  FUNCTION
  CLASS
  DEPENDENCY
  PACKAGE
  API_CLIENT
  API_OPERATION
  CONFIGURATION_KEY
  TEST
  SERVICE
  QUEUE_TOPIC
  DATABASE
}

enum GraphEdgeKind {
  CONTAINS
  EXPORTS
  IMPORTS
  CALLS
  EXTENDS
  DECLARES
  RESOLVES_TO
  USES_PACKAGE
  AFFECTED_BY
  CREATES_CLIENT
  INVOKES_API
  READS_CONFIG
  TESTS
  BELONGS_TO_SERVICE
  PUBLISHES
  CONSUMES
  ACCESSES
  CONFIGURES
  USES
  PROVIDES
  QUEUE_TOPIC
}

enum GraphProvenance {
  EXTRACTED
  RESOLVED
  INFERRED
  AMBIGUOUS
}

/**
 * One commit-versioned extraction of a repository. Immutable once READY;
 * impact queries only use the latest READY snapshot.
 */
model GraphSnapshot {
  id               String    @id @default(uuid())
  organizationId   String
  repositoryId     String
  commitSha        String
  extractionVersion Int       @default(1)
  status           GraphSnapshotStatus @default(INDEXING)
  rootTreeHash     String
  changedPaths     Json?
  nodesAffected    Int       @default(0)
  edgesAffected    Int       @default(0)
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  nodes        GraphNode[]
  edges        GraphEdge[]
  evidence     GraphSourceEvidence[]
  indexJobs    GraphIndexJob[]

  @@unique([repositoryId, commitSha, extractionVersion])
  @@index([organizationId, repositoryId, status])
  @@index([repositoryId, status, createdAt])
}

model GraphNode {
  id             String       @id @default(uuid())
  organizationId String
  repositoryId   String
  snapshotId     String
  kind           GraphNodeKind
  stableKey      String
  displayName    String
  filePath       String?
  startLine      Int?
  endLine        Int?
  propertiesJson Json?
  contentHash    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  snapshot     GraphSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  outEdges     GraphEdge[]   @relation("edgeFrom")
  inEdges      GraphEdge[]   @relation("edgeTo")
  evidence     GraphSourceEvidence[]

  @@unique([snapshotId, kind, stableKey])
  @@index([organizationId, repositoryId, snapshotId, kind])
  @@index([organizationId, snapshotId, filePath])
  @@index([repositoryId, stableKey])
  @@index([contentHash])
}

model GraphEdge {
  id             String        @id @default(uuid())
  organizationId String
  repositoryId   String
  snapshotId     String
  fromNodeId     String
  toNodeId       String
  kind           GraphEdgeKind
  provenance     GraphProvenance
  confidence     Int
  evidenceJson   Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  snapshot     GraphSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  fromNode     GraphNode     @relation("edgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       GraphNode     @relation("edgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  evidence     GraphSourceEvidence[]

  @@unique([snapshotId, kind, fromNodeId, toNodeId])
  @@index([organizationId, snapshotId, fromNodeId])
  @@index([organizationId, snapshotId, toNodeId])
  @@index([organizationId, snapshotId, kind])
}

/**
 * Immutable provenance record for a node or edge: where a fact came from,
 * which extractor produced it, and the source hash it was derived from.
 */
model GraphSourceEvidence {
  id               String  @id @default(uuid())
  organizationId   String
  repositoryId     String
  snapshotId       String
  nodeId           String?
  edgeId           String?
  filePath         String
  startLine        Int?
  endLine          Int?
  extractor        String
  extractorVersion String
  sourceHash       String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  snapshot     GraphSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  node         GraphNode?    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  edge         GraphEdge?    @relation(fields: [edgeId], references: [id], onDelete: Cascade)

  @@index([organizationId, repositoryId, snapshotId, nodeId], map: "graph_evidence_node_idx")
  @@index([organizationId, repositoryId, snapshotId, edgeId], map: "graph_evidence_edge_idx")
  @@index([snapshotId, extractor])
}

/** One graph extraction run (baseline or incremental); durable retry state. */
model GraphIndexJob {
  id               String          @id @default(uuid())
  organizationId   String
  repositoryId     String
  snapshotId       String?
  mode             GraphIndexMode
  status           GraphSnapshotStatus @default(INDEXING)
  changedPaths     Json?
  correlationId    String
  error            String?
  timingsJson      Json?
  startedAt        DateTime        @default(now())
  completedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  snapshot     GraphSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([organizationId, repositoryId, status])
  @@index([repositoryId, startedAt])
}

model VendorChangeEvent {
  id String @id @default(uuid())
  vendorId         String
  /** Owning organization; all reads/writes are scoped by it (multi-tenant). */
  organizationId   String?
  externalReference String?
  sourceType       VendorChangeSource
  detectedAt       DateTime           @default(now())
  effectiveAt      DateTime?
  title            String
  sourceUrl        String?
  rawPayload       Json?
  severity         Severity           @default(MEDIUM)
  status           VendorChangeStatus @default(DETECTED)
  createdAt        DateTime           @default(now())

  vendor          Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  normalizations  NormalizedChange[]
  impactAssessments ImpactAssessment[]

  @@index([vendorId, status])
  @@index([status, createdAt])
  @@index([detectedAt])
  @@index([organizationId, status])
}

model NormalizedChange {
  id String @id @default(uuid())
  changeEventId String
  changeType    ChangeType
  oldValue      String?
  newValue      String?
  description   String?
  breaking      Boolean    @default(false)
  evidence      Json?
  createdAt     DateTime   @default(now())

  changeEvent     VendorChangeEvent  @relation(fields: [changeEventId], references: [id], onDelete: Cascade)

  @@index([changeEventId])
  @@index([changeType])
}

model IntegrationUsage {
  id String @id @default(uuid())
  organizationId     String
  repositoryId       String
  scanId             String?
  vendorId           String
  filePath           String
  symbol             String
  usageType          UsageType
  astLocation        Json?
  surroundingCodeHash String?
  codeExcerpt        Json?
  metadata           Json?
  ownerHint          String   @default("Unassigned")
  riskTags           RiskTag[] @default([])
  createdAt          DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  scan         RepositoryScan? @relation(fields: [scanId], references: [id], onDelete: SetNull)
  vendor       Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assessments  ImpactAssessmentUsage[]

  @@index([organizationId])
  @@index([repositoryId, vendorId])
  @@index([filePath])
  @@index([symbol])
  @@index([scanId])
}

model ImpactAssessment {
  id String @id @default(uuid())
  organizationId     String
  changeEventId      String
  repositoryId       String
  score              Int
  confidence         Int
  affectedUsageCount Int          @default(0)
  riskLevel          RiskLevel
  rationale          String
  status             ImpactStatus
  createdAt          DateTime     @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  changeEvent  VendorChangeEvent  @relation(fields: [changeEventId], references: [id], onDelete: Cascade)
  repository   Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  affectedUsages ImpactAssessmentUsage[]
  plans        RemediationPlan[]

  @@unique([changeEventId, repositoryId])
  @@index([organizationId])
  @@index([repositoryId])
  @@index([status])
  @@index([createdAt])
}

model ImpactAssessmentUsage {
  organizationId     String
  impactAssessmentId String
  usageId            String

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  impactAssessment ImpactAssessment @relation(fields: [impactAssessmentId], references: [id], onDelete: Cascade)
  usage            IntegrationUsage @relation(fields: [usageId], references: [id], onDelete: Cascade)

  @@id([impactAssessmentId, usageId])
  @@index([organizationId])
  @@index([usageId])
}

model RemediationPlan {
  id String @id @default(uuid())
  organizationId      String
  impactAssessmentId  String
  status              PlanStatus @default(DRAFT)
  strategy            String
  proposedChanges     Json?
  confidence          Int
  requiresHumanReview Boolean    @default(false)
  policyDecision      Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  impactAssessment ImpactAssessment @relation(fields: [impactAssessmentId], references: [id], onDelete: Cascade)
  patches          PatchArtifact[]
  validations      ValidationRun[]
  pullRequests     PullRequest[]
  approvals        Approval[]

  @@index([organizationId])
  @@index([impactAssessmentId])
  @@index([status])
  @@index([createdAt])
}

model PatchArtifact {
  id String @id @default(uuid())
  organizationId    String
  remediationPlanId String
  filePath          String
  unifiedDiff       String
  originalContent   String
  patchedContent    String
  originalHash      String
  patchedHash       String
  generationMethod  GenerationMethod
  confidence        Int
  createdAt         DateTime         @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediationPlan RemediationPlan @relation(fields: [remediationPlanId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([remediationPlanId])
}

model ValidationRun {
  id String @id @default(uuid())
  organizationId    String
  remediationPlanId String
  status            ValidationStatus @default(QUEUED)
  commands          Json
  stdout            String?
  stderr            String?
  exitCode          Int?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime         @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediationPlan RemediationPlan @relation(fields: [remediationPlanId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([remediationPlanId])
  @@index([status])
  @@index([createdAt])
}

model PullRequest {
  id String @id @default(uuid())
  organizationId    String
  remediationPlanId String
  provider          String
  externalId        String?
  url               String
  branchName        String
  status            PullRequestStatus @default(DRAFT)
  createdAt         DateTime          @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediationPlan RemediationPlan @relation(fields: [remediationPlanId], references: [id], onDelete: Cascade)

  @@unique([remediationPlanId])
  @@index([organizationId])
  @@index([status])
}

model Policy {
  id String @id @default(uuid())
  organizationId String
  name           String
  enabled        Boolean  @default(true)
  definitionJson Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Approval {
  id String @id @default(uuid())
  organizationId    String
  remediationPlanId String
  userId            String
  decision          ApprovalDecision
  note              String?
  createdAt         DateTime         @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  remediationPlan RemediationPlan @relation(fields: [remediationPlanId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([remediationPlanId, userId, decision])
  @@index([organizationId])
  @@index([remediationPlanId])
}

model AuditEvent {
  id String @id @default(uuid())
  organizationId String
  actorType     ActorType
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  correlationId String?
  beforeJson    Json?
  afterJson     Json?
  metadata      Json?
  createdAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([correlationId])
}
