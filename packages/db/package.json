{
  "name": "@patchbay/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "reset": "dotenv -e ../../.env -- prisma migrate reset --force && pnpm seed",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@patchbay/audit": "workspace:*",
    "@patchbay/domain": "workspace:*",
    "@prisma/client": "^6.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^6.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
